# ==============================================================================
# JOURNAL∞ ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# IMPORTANT: DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO GIT.
# Copy this file to .env.local for local development.
# In Production / Staging (Cloud Run), inject secrets via Google Secret Manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CONFIGURATION (Exposed to Client Bundle via VITE_ Prefix)
# ------------------------------------------------------------------------------
# Firebase Web App Public SDK Credentials (Public by Design)
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
VITE_FIREBASE_API_KEY="AIzaSyYourWebApiKeyHerePlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-geminijournalref-07d208be-ffdc-41ac-9ad4-a205122972b6"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_OAUTH_CLIENT_ID="1234567890-abcdef.apps.googleusercontent.com"

# Client-Side Google Maps API (Restricted to Maps JS API domain origin)
VITE_GOOGLE_MAPS_CLIENT_ID="1234567890-abcdef.apps.googleusercontent.com"

# Optional App Check / ReCAPTCHA Enterprise Site Key (Client-side)
VITE_RECAPTCHA_SITE_KEY=""
VITE_APPCHECK_DEBUG_TOKEN=""

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY CONFIGURATION (Never Exposed to Frontend Client Bundle)
# ------------------------------------------------------------------------------
# Environment mode ('development', 'staging', 'production')
NODE_ENV="development"

# Server Port (Cloud Run injects PORT automatically, defaults to 3000)
PORT="3000"

# Application Base URL (Used for CORS origin validation, webhooks, and self-links)
APP_URL="https://gemini-journal-staging-618285014094.us-central1.run.app"

# Disable Hot Module Replacement (Optional debug toggle for local Vite testing)
DISABLE_HMR="false"

# ------------------------------------------------------------------------------
# 3. SECRETS (Production Secrets -> Inject via Google Secret Manager)
# ------------------------------------------------------------------------------
# Gemini AI API Key (REQUIRED for AI features)
# GCP Secret Manager Secret Name: journal-gemini-api-key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Server-side Google Maps Places API Key (Restricted to Places API IP / HTTP referrer)
# GCP Secret Manager Secret Name: journal-maps-api-key
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"

# Admin User Email Authorization List (Comma-separated)
# GCP Secret Manager Secret Name: journal-admin-emails
ADMIN_EMAILS="admin@example.com,lead@example.com"

# Firebase Admin Service Account Credentials (Server-only privileged access)
# Local Dev Path: ./sa-keys/firebase-admin.json (Never committed)
FIREBASE_SERVICE_ACCOUNT_PATH="./sa-keys/firebase-admin.json"

# Production Secret Manager Injection (Inline JSON String from GCP Secret Manager)
# GCP Secret Manager Secret Name: journal-firebase-sa-json
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Standard GCP Application Default Credentials Path (Fallback)
GOOGLE_APPLICATION_CREDENTIALS=""

# ------------------------------------------------------------------------------
# 4. FIREBASE CONFIGURATION SUMMARY
# ------------------------------------------------------------------------------
# Client: VITE_FIREBASE_PROJECT_ID, VITE_FIREBASE_APP_ID, VITE_FIREBASE_API_KEY,
#         VITE_FIREBASE_AUTH_DOMAIN, VITE_FIREBASE_FIRESTORE_DATABASE_ID,
#         VITE_FIREBASE_STORAGE_BUCKET, VITE_FIREBASE_MESSAGING_SENDER_ID
# Server: FIREBASE_SERVICE_ACCOUNT_JSON or FIREBASE_SERVICE_ACCOUNT_PATH

# ------------------------------------------------------------------------------
# 5. GEMINI CONFIGURATION SUMMARY
# ------------------------------------------------------------------------------
# Gemini API Key: GEMINI_API_KEY (or GEMINI_API_KEY_SECRET)
# Fallback Ladder: gemini-3.6-flash -> gemini-3.1-flash-lite -> gemini-flash-latest -> gemini-3.7-flash

# ------------------------------------------------------------------------------
# 6. CLOUD RUN CONFIGURATION SUMMARY
# ------------------------------------------------------------------------------
# Port: 3000 (Exposed via Dockerfile container PORT)
# Service Account: Cloud Run Runtime Service Account (journal-app-sa@<project>.iam.gserviceaccount.com)
# Secrets Binding: --set-secrets="GEMINI_API_KEY=journal-gemini-api-key:latest,GOOGLE_MAPS_API_KEY=journal-maps-api-key:latest,ADMIN_EMAILS=journal-admin-emails:latest,FIREBASE_SERVICE_ACCOUNT_JSON=journal-firebase-sa-json:latest"

# ------------------------------------------------------------------------------
# 7. STORAGE CONFIGURATION SUMMARY
# ------------------------------------------------------------------------------
# Storage Bucket: VITE_FIREBASE_STORAGE_BUCKET
# Path Structure: users/{uid}/journal-media/{year}/{month}/{filename}
