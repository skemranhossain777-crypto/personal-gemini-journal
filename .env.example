# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration (VITE_ prefix for client-side access)
# AI Studio injects these automatically. For local development, copy to .env.local.
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:xxxxx:web:xxxxx"
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="your-firestore-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_OAUTH_CLIENT_ID="123456789-xxxxx.apps.googleusercontent.com"

# Google Maps Configuration
# GOOGLE_MAPS_API_KEY: Server-side key for Places Autocomplete API (restricted to Places API)
GOOGLE_MAPS_API_KEY="AIzaSy..."
# VITE_GOOGLE_MAPS_CLIENT_ID: Client-side Maps JavaScript API key (for map preview)
VITE_GOOGLE_MAPS_CLIENT_ID="xxxxx.apps.googleusercontent.com"

# Admin Configuration
# ADMIN_EMAILS: Comma-separated list of email addresses that receive admin role on first login
ADMIN_EMAILS="admin@example.com"
